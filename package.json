{
  "name": "ultrasudo",
  "version": "1.0.0",
  "description": "Secure, private desktop environment with peer-to-peer transfers and cloud sync.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:frontend": "vite build",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "electron:dev:all": "concurrently \"npm run dev\" \"npm run electron:dev\"",
    "electron:test": "npm run build:frontend && electron .",
    "electron:pack": "npm run build:frontend && electron-builder --dir",
    "electron:win": "npm run build:frontend && electron-builder --win",
    "electron:linux": "npm run build:frontend && electron-builder --linux",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "start": "npm run electron:dev:all"
  },
  "author": "Ultrasudo",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.10.0",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "fs-extra": "^11.3.3",
    "javascript-obfuscator": "^5.3.0",
    "terser": "^5.46.0",
    "vite": "^7.3.1",
    "vite-plugin-javascript-obfuscator": "^3.1.0"
  },
  "build": {
    "appId": "com.ultrasudo.app",
    "productName": "Ultrasudo",
    "asar": true,
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "images/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!**/*.map",
      "!src/**/*",
      "!src-tauri/**/*",
      "!*.md",
      "!.git/**/*",
      "!.gemini/**/*"
    ],
    "extraResources": [
      {
        "from": "system-manager/target/release",
        "to": "system-manager",
        "filter": [
          "system-manager",
          "system-manager.exe"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Ultrasudo <contact@ultrasudo.io>"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "images/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "images/icon.icns",
      "category": "public.app-category.utilities"
    }
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.11"
  }
}
